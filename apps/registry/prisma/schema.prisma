generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String   @id @default(uuid())
  email           String   @unique
  password        String
  name            String?
  humanPublicKey  String
  humanPrivateKey String
  createdAt       DateTime @default(now())
  agents          Agent[]
}

model Agent {
  id              String   @id @default(uuid())
  agentId         String   @unique
  apiKey          String   @unique
  agentPublicKey  String
  agentPrivateKey String
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  createdAt       DateTime @default(now())
  proofs          Proof[]
}

model Proof {
  id             String   @id @default(uuid())
  type           String
  agentId        String
  sessionId      String?
  timestamp      DateTime
  content        Json
  agentSignature String
  humanSignature String?
  createdAt      DateTime @default(now())
  agent          Agent    @relation(fields: [agentId], references: [agentId])

  @@index([agentId])
  @@index([sessionId])
  @@index([agentId, sessionId])
}